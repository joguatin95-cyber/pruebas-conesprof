# ---------------------------------------------------------------------------
# Clave secreta de Flask (generada automaticamente, no la comparta)
# ---------------------------------------------------------------------------
SECRET_KEY=cambie-esta-clave-por-una-larga-y-aleatoria

# ---------------------------------------------------------------------------
# CONEXION A POSTGRESQL EN RENDER
#
# 1. Entre a https://dashboard.render.com
# 2. Abra su base de datos PostgreSQL
# 3. En la seccion "Connections" copie la  >>> External Database URL <<<
#    (NO la Internal Database URL: esa solo funciona dentro de Render)
# 4. Peguela abajo, reemplazando por completo la linea DATABASE_URL=
#
# Se ve parecida a esto:
#   postgresql://mi_usuario:LaRgAcLaVe@dpg-xxxxx-a.oregon-postgres.render.com/mi_base
#
# No hace falta cambiarle el formato: la aplicacion la adapta sola y le agrega
# el cifrado TLS que Render exige.
# ---------------------------------------------------------------------------
DATABASE_URL=PEGUE_AQUI_LA_EXTERNAL_DATABASE_URL_DE_RENDER

# ---------------------------------------------------------------------------
# Administrador inicial que creara seed.py (cambie la contrasena luego de entrar)
# ---------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=DefinaUnaClaveFuerteAqui
ADMIN_NOMBRE=Administrador General
ADMIN_EMAIL=correo@suempresa.com
